local loopConnection = nil
local value = 0

local function startLoop()
	if loopConnection then return end
	value = 0
	loopConnection = RunService.RenderStepped:Connect(function(dt)
		value = value + 160 * dt
		if value >= 100 then value = 0 end
		barFill.Size = UDim2.new(value/100, 0, 1, 0)
		percent.Text = value > 0 and math.floor(value).."%" or ""
	end)
end

local function stopLoop()
	if loopConnection then
		loopConnection:Disconnect()
		loopConnection = nil
	end
	barFill.Size = UDim2.new(0, 0, 1, 0)
	percent.Text = ""
	value = 0
end

autoBtn.MouseButton1Click:Connect(function()
	autoOn = not autoOn
	if autoOn then
		autoBtn.Text = "Auto Grab On"
		autoBtn.BackgroundColor3 = Color3.fromRGB(25, 110, 55)
		startLoop()
	else
		autoBtn.Text = "Auto Grab Off"
		autoBtn.BackgroundColor3 = Color3.fromRGB(22, 30, 58)
		stopLoop()
	end
end)

local locked = false
lockBtn.MouseButton1Click:Connect(function()
	locked = not locked
	lockBtn.Text = locked and "🔒" or "🔓"
	lockBtn.BackgroundColor3 = locked and Color3.fromRGB(25, 110, 55) or Color3.fromRGB(30, 55, 120)
end)

local minimized = false
local fullSize = main.Size

minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	if minimized then
		content.Visible = false
		main.Size = UDim2.new(0, 240, 0, 38)
		minBtn.Text = "+"
	else
		content.Visible = true
		main.Size = fullSize
		minBtn.Text = "–"
	end
end)

local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
	if locked then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

titleBar.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if locked or not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
end)

